<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Image store writes to filesDir/images/<noteId>/<sha256>.webp (see AndroidImageStore). -->
    <files-path
        name="images"
        path="images/" />
    <!-- Settings export writes to getExternalFilesDir()/nknote-export-<ts>.json. -->
    <external-files-path
        name="exports"
        path="." />
</paths>
